# ==============================================================================
# SHREE RADHE KRISHNA DIGITAL SERVICE — JARVIS & WACRM OS
# Canonical Environment Configuration Template (.env.example)
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application & Domain URL
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
NEXT_PUBLIC_APP_LOCALE=en

# Meta / WhatsApp Business Cloud API Integration
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# Optional / Feature Flags
AI_CONTEXT_MESSAGE_LIMIT=20
AI_REQUEST_TIMEOUT_MS=15000
AUTOMATION_CRON_SECRET=your-cron-secret
ALLOWED_INVITE_HOSTS=
WHATSAPP_TEMPLATES_DRY_RUN=false
