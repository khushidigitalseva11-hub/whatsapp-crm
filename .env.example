# ==============================================================================
# SHREE RADHE KRISHNA DIGITAL SERVICE — JARVIS & WACRM OS
# Canonical Master Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Required)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Application & Domain URL (Required)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
NEXT_PUBLIC_APP_LOCALE=en

# ------------------------------------------------------------------------------
# 3. Meta / WhatsApp Cloud Business API (Required for private CRM)
# ------------------------------------------------------------------------------
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# ------------------------------------------------------------------------------
# 4. Optional External AI & Intelligence Providers (Fallback active if omitted)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
FLOW_AI_API_KEY=

# ------------------------------------------------------------------------------
# 5. Optional Social Media Publishing (Manual export fallback active if omitted)
# ------------------------------------------------------------------------------
INSTAGRAM_ACCOUNT_ID=
META_USER_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 6. Optional Payment Gateway (Citizen applications)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------------------------
# 7. Engine Tuning & System Flags
# ------------------------------------------------------------------------------
AI_CONTEXT_MESSAGE_LIMIT=20
AI_REQUEST_TIMEOUT_MS=15000
AUTOMATION_CRON_SECRET=
ALLOWED_INVITE_HOSTS=
WHATSAPP_TEMPLATES_DRY_RUN=false
